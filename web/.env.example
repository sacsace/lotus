# Local SQLite file. On Railway this is file:/data/lotus.db on a volume mounted at /data.
DATABASE_URL="file:./dev.db"
# Optional. Local default is public/uploads. On Railway use /data/uploads so photos survive redeploys.
UPLOAD_DIR=""
DEFAULT_TENANT_SLUG="lotus-india"
LOTUS_ADMIN_PASSWORD="admin123"
LOTUS_ADMIN_JWT_SECRET="lotus-dev-jwt-secret-min-32-characters-long"
MVS_BASE_URL=""
MVS_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Lotus Korean hotel"
# Optional extra inquiry recipients (comma-separated). Defaults always include hello@hotellotus.in and lee@msventures.in.
INQUIRY_TO=""
NEXT_PUBLIC_SITE_URL="https://www.hotellotus.in"
# Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID="GTM-MXGDPK8S"
